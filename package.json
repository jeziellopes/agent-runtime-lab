{
  "name": "agent-runtime-lab",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "One AI agent runtime core, two framework adapters, four deployment cells, and a contract suite proving the only thing that changed was the framework.",
  "type": "commonjs",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "start": "node scripts/start.mjs",
    "contract-test": "node packages/contract-tests/dist/cli.js",
    "benchmark": "node scripts/benchmark.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "catalog:",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
